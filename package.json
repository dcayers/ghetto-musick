{
  "name": "flowgraph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @flowgraph/db generate",
    "db:migrate": "pnpm --filter @flowgraph/db migrate",
    "dev:api": "pnpm --filter @flowgraph/api dev",
    "db:status": "pnpm --filter @flowgraph/db exec prisma migrate status",
    "openapi": "pnpm --filter @flowgraph/api run openapi:generate",
    "api-client:generate": "pnpm --filter @flowgraph/api-client run generate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.4.3"
    }
  }
}
