// FlowGraph schema.
//
// Migration sequence follows plan §23.2. This is step 1 (identity, workspace)
// and step 2 (track), which is what the Phase 0 vertical slice needs. Graph,
// transition, marker, and set models follow in later migrations.
//
// IDs are UUIDv7 generated application-side — ADR-0003. Prisma has no default
// for that, which is deliberate: `newId()` from @flowgraph/contracts is the
// only generator, so the bridge and web app can mint IDs offline too.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// Prisma 7 removed `url` from the datasource block. The connection string for
// Migrate now lives in ../prisma.config.ts, and the runtime client connects
// through a driver adapter (@prisma/adapter-pg). See ADR-0008.
datasource db {
  provider = "postgresql"
}

// --- Identity and tenancy ---------------------------------------------------

model Workspace {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  tracks  Track[]

  @@map("workspaces")
}

// --- Identity: owned by better-auth (ADR-0004) -------------------------------
//
// The four models below (User, Session, Account, Verification) follow
// better-auth's expected shape. Field names are its convention, not ours —
// `name` rather than `displayName`, `emailVerified` as a required boolean.
// Do not rename them to match house style; the adapter maps by name.
//
// IDs here are text, not @db.Uuid: better-auth generates its own identifiers
// and they are not UUIDv7. ADR-0003 governs identifiers *we* mint.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // Domain relation — not part of better-auth's schema.
  memberships WorkspaceMember[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Holds both password credentials and linked OAuth providers. Spotify tokens
// land here via account linking rather than in a parallel mechanism (§7.1).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

// Every resource hangs off a Workspace rather than a User, even though MVP
// creates exactly one personal workspace per user (plan §7.1). Retrofitting
// tenancy later is brutal; a single OWNER row costs nothing now.
model WorkspaceMember {
  id          String        @id @db.Uuid
  workspaceId String        @db.Uuid
  // Text, not uuid — this references better-auth's User.id, which it mints
  // in its own format. Our own ids remain UUIDv7 (ADR-0003).
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// --- Track library ----------------------------------------------------------

model Track {
  id String @id @db.Uuid

  workspaceId String @db.Uuid

  title  String
  artist String

  // Decimal, not Float — plan §7.2. BPM participates in exact comparisons
  // (transition tempo windows, duplicate detection) where binary float drift
  // produces wrong answers.
  bpm Decimal? @db.Decimal(6, 2)

  // Camelot notation, e.g. "8A". Validated at the contract boundary.
  keySignature  String?
  timeSignature String?

  tags String[]

  // Optimistic concurrency for PATCH via If-Match — plan §6.3.
  version Int @default(1)

  // Soft delete: tracks are referenced by graph nodes and set items, so a hard
  // delete would orphan planning data the user still needs.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Cursor pagination index. UUIDv7 is time-ordered (ADR-0003), so
  // (createdAt, id) is a stable, total ordering usable as a cursor.
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, bpm])
  @@map("tracks")
}
