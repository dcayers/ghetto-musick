# Copy to .env and adjust. Ports are offset to avoid colliding with any
# system-local Postgres/Redis/MinIO already listening on the defaults.

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://flowgraph:flowgraph@localhost:55432/flowgraph?schema=public"

# --- Redis (queues, locks, rate limiting) ---------------------------------
REDIS_URL="redis://localhost:56379"

# --- Object storage (S3-compatible) ---------------------------------------
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY_ID="flowgraph"
S3_SECRET_ACCESS_KEY="flowgraph"
S3_BUCKET="flowgraph-local"

# --- API ------------------------------------------------------------------
NODE_ENV="development"
API_PORT="4000"
API_HOST="127.0.0.1"

# --- Auth ------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-me-with-at-least-32-characters-of-random"
AUTH_BASE_URL="http://127.0.0.1:4000"
AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# --- Secrets ---------------------------------------------------------------
# Never commit real values. Production reads these from a secret manager.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
